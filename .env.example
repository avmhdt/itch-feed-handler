# ---- Paths -------------------------------------------------------------
DATA_ROOT=/home/USER/data/itch-feed-handler   # REQUIRED. Inside the WSL2 ext4 filesystem, never /mnt/*. Write it absolute: the C++ CLI expands ${VAR} but not ~.
ITCH_DATA_DIR=/home/USER/data/itch-feed-handler   # REQUIRED. Root for raw/, interim/, reference/ and canonical datasets; the repo's data/ is a symlink to it.
ITCH_REFERENCE_DAILY_DIR=/home/USER/data/itch-feed-handler/reference/daily   # REQUIRED before M4.
SHARADAR_API_KEY=                    # owner sets it. Default source of official closes. Empty = Stooq fallback.
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq   # Owner's Stooq snapshot; read once, converted to Parquet under data/.
TIINGO_API_KEY=                      # optional, normally unneeded.
# ---- Download ------------------------------------------------------------
ITCH_BASE_URL=https://emi.nasdaq.com/ITCH/Nasdaq%20ITCH/   # optional. Sample-file directory.
ITCH_DAYS=01302019,03272019,01302020   # optional. MMDDYYYY list (D-01 default).
ITCH_KEEP_GZ=true                    # optional. Keep .gz after decompression.
ITCH_MAX_BYTES_PER_S=10000000        # optional. Download cap; the connection is shared with live recorders.
# ---- Reference parser and benchmarks ---------------------------------------
ITCH_REF_PARSER_BIN=/home/USER/build/itch-feed-handler/cargo/release/ref_counts   # required from M2.
ITCH_BENCH_MACHINE=owner-desktop-wsl2   # required from M6. Label written into every benchmark row.
# ---- Transport (MoldUDP64 demo) --------------------------------------------
ITCH_MCAST_GROUP=239.192.0.1         # optional. Administratively scoped multicast group.
ITCH_MCAST_PORT=30001                # optional. Multicast data port.
ITCH_MCAST_IFACE=127.0.0.1           # optional. Interface address for IP_MULTICAST_IF / IP_ADD_MEMBERSHIP.
ITCH_RETRANS_PORT=30002              # optional. Unicast re-request server port.
ITCH_MOLD_SESSION=ITCHDEMO01         # optional. Exactly 10 ASCII characters.
# ---- Logging ---------------------------------------------------------------
ITCH_LOG_LEVEL=info                  # optional. trace|debug|info|warn|error
ITCH_LOG_FORMAT=text                 # optional. text|json
